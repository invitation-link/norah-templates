# Environment Variables for InviteKaro

# ===========================================
# REQUIRED: Supabase Configuration
# Get these from: https://supabase.com/dashboard/project/_/settings/api
# ===========================================

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ===========================================
# OPTIONAL: Razorpay Payment Integration
# Get these from: https://dashboard.razorpay.com/app/keys
# ===========================================

NEXT_PUBLIC_RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# ===========================================
# SETUP INSTRUCTIONS
# ===========================================

# 1. SUPABASE SETUP:
#    a) Create account at https://supabase.com
#    b) Create new project
#    c) Go to SQL Editor and run the contents of: supabase/schema.sql
#    d) Go to Settings > API > Copy keys to this file
#    e) Enable Phone Auth in Authentication > Providers (optional)
#    f) Enable Google Auth in Authentication > Providers (optional)

# 2. RAZORPAY SETUP (for payments):
#    a) Create account at https://razorpay.com
#    b) Complete KYC verification
#    c) Go to Settings > API Keys > Generate Keys
#    d) Copy Key ID and Key Secret to this file
#    e) Install SDK: npm install razorpay

# 3. AFTER CONFIGURATION:
#    Rename this file to .env.local and restart dev server
