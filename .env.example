# Environment Variables for Invite Link

# Public site and analytics
NEXT_PUBLIC_SITE_URL=https://invitelink.shop
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_AD_PROVIDER=house
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_SLOT_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-81CCB5ZMLX
NEXT_PUBLIC_CLARITY_PROJECT_ID=wzp3yr2x2l

# ===========================================
# REQUIRED: Supabase Configuration
# Get these from: https://supabase.com/dashboard/project/_/settings/api
# ===========================================

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ===========================================
# SETUP INSTRUCTIONS
# ===========================================

# 1. SUPABASE SETUP:
#    a) Create account at https://supabase.com
#    b) Create new project
#    c) Apply the versioned files in supabase/migrations in order
#    d) Go to Settings > API > Copy keys to this file
#    e) Enable email magic links and Google in Authentication > Providers
#    f) Keep phone OTP disabled until an SMS provider and abuse controls are configured

# 2. RAZORPAY SETUP (for payments):
#    a) Create account at https://razorpay.com
#    b) Complete KYC verification
#    c) Go to Settings > API Keys > Generate Keys
#    d) Copy Key ID and Key Secret to this file
#    e) Add a signed webhook for /api/payments/webhook

# 3. AFTER CONFIGURATION:
#    Rename this file to .env.local and restart dev server
