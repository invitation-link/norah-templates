{
  "buildCommand": "",
  "outputDirectory": ".",
  "cleanUrls": true,
  "redirects": [
    { "source": "/occasions/wedding", "destination": "/templates/wedding/", "permanent": true },
    { "source": "/occasions/birthday", "destination": "/templates/birthday/", "permanent": true },
    { "source": "/occasions/housewarming", "destination": "/templates/housewarming/", "permanent": true },
    { "source": "/occasions/celebrations", "destination": "/templates", "permanent": true }
  ],
  "rewrites": [
    { "source": "/create", "destination": "/create.html" },
    { "source": "/templates", "destination": "/templates.html" },
    { "source": "/pricing", "destination": "/pricing.html" },
    { "source": "/faq", "destination": "/faq.html" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/refund", "destination": "/refund.html" },
    { "source": "/guides", "destination": "/guides/index.html" },
    { "source": "/guides/how-to-create-digital-invitation", "destination": "/guides/how-to-create-digital-invitation/index.html" },
    { "source": "/guides/digital-invitation-vs-video-invitation", "destination": "/guides/digital-invitation-vs-video-invitation/index.html" },
    { "source": "/guides/whatsapp-wedding-invitation-guide", "destination": "/guides/whatsapp-wedding-invitation-guide/index.html" },
    { "source": "/guides/what-to-write-on-housewarming-invitation", "destination": "/guides/what-to-write-on-housewarming-invitation/index.html" },
    { "source": "/templates/wedding", "destination": "/templates/wedding/index.html" },
    { "source": "/templates/birthday", "destination": "/templates/birthday/index.html" },
    { "source": "/templates/housewarming", "destination": "/templates/housewarming/index.html" },
    { "source": "/templates/varalakshmi-vratham", "destination": "/templates/varalakshmi-vratham/index.html" },
    { "source": "/templates/wedding/floral-indian-wedding", "destination": "/templates/wedding/floral-indian-wedding/index.html" },
    { "source": "/templates/birthday/under-the-sea-birthday", "destination": "/templates/birthday/under-the-sea-birthday/index.html" },
    { "source": "/templates/housewarming/traditional-indian", "destination": "/templates/housewarming/traditional-indian/index.html" },
    { "source": "/manifest.json", "destination": "/manifest.json" },
    { "source": "/site.webmanifest", "destination": "/manifest.json" },
    { "source": "/invite/:slug", "destination": "/invite.html" },
    { "source": "/u/:slug", "destination": "/invite.html" },
    { "source": "/i/:slug", "destination": "/invite.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    },
    {
      "source": "/invite/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/u/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/i/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/invite.html",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*).css",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(.*).js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
